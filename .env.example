# CivicConnect Environment Variables Example
# Duplicate this file to .env and configure for your environment.
# NEVER commit your production .env or secrets to version control.

# Flask Application Secret Key (generate a strong random secret in production)
SECRET_KEY=civicconnect-dev-secret-replace-with-secure-key-32chars

# Database Connection URL
# For MySQL 8 (Production default):
# DATABASE_URL=mysql+pymysql://civic_user:civic_password@localhost:3306/civicconnect_db
# For SQLite (Local development / testing fallback):
DATABASE_URL=sqlite:///civicconnect.db

# Flask Environment ('development' or 'production')
FLASK_ENV=development
FLASK_DEBUG=True

# Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=2097152

# Rate Limiting (Flask-Limiter)
RATELIMIT_ENABLED=True
RATELIMIT_STORAGE_URI=memory://

# Optional Map Feature (Leaflet + OpenStreetMap approximate area)
# Default is False per specification
ENABLE_MAP=False

# Initial Admin Account (Required for headless cloud deployments like Render without Shell)
# If ADMIN_PASSWORD is set, the app creates this administrator on first startup.
# Existing admin accounts are NEVER overwritten on restarts.
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@civicconnect.local
ADMIN_PASSWORD=SetAStrongPasswordHere123!
